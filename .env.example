# Copy this file to .env (same directory as app.py) and fill in real values.
# .env is loaded automatically by app.py at startup (see load_dotenv() near
# the top) — you do not need to `export` these yourself for local dev.
# Never commit the real .env file — keep it out of version control.

# ── Saaras (Sarvam) — pronunciation + STT provider ───────────────────────────
# Required for both SaarasPronunciationProvider and SaarasSTTProvider (same
# account/key, two different endpoints). Without this, /stt-providers and
# /pronunciation-providers will both report "saaras": {"available": false}
# and every request falls back to Whisper.
SARVAM_API_KEY=Sarvam_API_key

# Optional — only set if you're not using Sarvam's default API host.
# SARVAM_API_URL=https://api.sarvam.ai

# Optional — BCP-47 code (e.g. en-IN). Leave unset to let Saaras
# auto-detect the spoken language.
# SARVAM_LANGUAGE_CODE=en-IN

# ── Local LLM pronunciation provider ─────────────────────────────────────────
# Optional. Only set this once a local pronunciation-scoring inference
# server actually exists and is running — see LocalLLMPronunciationProvider
# in pronunciation_provider.py for why this is unimplemented today.
# LOCAL_LLM_URL=
